// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Expense {
  id              Int      @id @default(autoincrement())
  serialNumber    Int      // 연번
  executionDate   DateTime // 집행완료일
  purpose         String   // 집행목적
  evidenceType    String   // 증빙유형
  item            String   // 품목
  vendorName      String?  // 거래처명
  bankName        String?  // 입금은행
  accountHolder   String?  // 예금주명
  accountNumber   String?  // 입금계좌번호
  amount          Float    // 집행금액
  subsidyCategory String?  // 보조세목
  fundSource      String?  // 재원
  supplyPrice     Float?   // 공급가액
  vat             Float?   // 부가세
  balance         Float?   // 잔액
  approvalStatus  String   @default("pending") // 도서관장 허가: pending/approved/rejected
  note            String?  // 비고
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
